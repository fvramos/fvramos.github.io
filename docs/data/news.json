      "title": "New Peregrine revision on arXiv",
      "image": "assets/peregrine-overview.png",
      "image_alt": "Peregrine computes ML features before sampling",
      "image_class": "news-image",
      "image_link": "https://arxiv.org/abs/2403.18788",
      "body": [
        {
          "text": "Peregrine",
          "url": "https://arxiv.org/abs/2403.18788"
        },
        {
          "text": " is the first ML-based intrusion detector to preserve detection effectiveness in terabit networks. The key: compute features before sampling. Our updated paper is now on arXiv."
        }
      ]
    },
